rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Issues Collection
    match /issues/{issueId} {
      // 1. Only authenticated users can read/write
      allow read: if request.auth != null;
      
      // 2. Writes must be authenticated and valid
      allow write: if request.auth != null 
                   && request.resource.data.employeeRoleLevel is number;
    }
    
    // Users Collection
    match /users/{userId} {
      // 1. Authenticated users can read directory
      allow read: if request.auth != null;
      
      // 2. Only authenticated users can write (App enforces Admin check)
      allow write: if request.auth != null;
    }
  }
}
